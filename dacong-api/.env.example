# Supabase 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============================================
# Supabase 配置
# ============================================

# Supabase 项目 URL
# 格式: https://your-project-id.supabase.co
# 获取方式: Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase 匿名密钥（客户端使用）
# 获取方式: Supabase Dashboard > Settings > API > anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase 服务端密钥（服务端使用，保密！）
# 获取方式: Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# 数据库连接（可选）
# ============================================

# PostgreSQL 连接字符串
# 格式: postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres
# 获取方式: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# ============================================
# API 配置
# ============================================

# API 端口
PORT=3000

# API 基础路径
API_BASE_PATH=/api/v1

# CORS 允许的域名（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# 爬虫配置
# ============================================

# GitHub Token（用于提高 API 限流）
GITHUB_TOKEN=ghp_xxxxx

# OpenRouter API Key（用于 AI 生成内容）
OPENROUTER_API_KEY=sk-or-xxxxx

# ============================================
# 日志配置
# ============================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 日志格式: json, pretty
LOG_FORMAT=pretty

# ============================================
# Redis 缓存配置
# ============================================

# Redis 连接 URL
# 格式: redis://[:password@]host:port[/db]
# 本地开发: redis://localhost:6379
# Docker: redis://:redis123@redis:6379
REDIS_URL=redis://localhost:6379

# Redis 主机（可选，如果使用 REDIS_URL 则忽略）
REDIS_HOST=localhost

# Redis 端口（可选）
REDIS_PORT=6379

# Redis 密码（可选）
REDIS_PASSWORD=

# Redis 数据库编号（可选，默认 0）
REDIS_DB=0

# 缓存默认 TTL（秒）
CACHE_TTL=300

# ============================================
# 环境
# ============================================

# 运行环境: development, production, test
NODE_ENV=development
ENVIRONMENT=development

# ============================================
# 开发模式配置（仅开发环境生效）
# ============================================

# 是否启用 CSRF 验证（默认: false）
DEV_ENABLE_CSRF=false

# 是否启用认证验证（默认: false）
DEV_ENABLE_AUTH=false

# 是否启用输入验证（默认: false）
DEV_ENABLE_INPUT_VALIDATION=false

# 是否启用 SQL 注入防护（默认: false）
DEV_ENABLE_SQL_INJECTION_PROTECTION=false

# 是否启用 XSS 防护（默认: false）
DEV_ENABLE_XSS_PROTECTION=false

# 是否启用速率限制（默认: false）
DEV_ENABLE_RATE_LIMIT=false
