# ============================================
# 测试环境配置
# ============================================
# 此文件用于测试环境部署，不要提交到 Git

# ============================================
# 环境标识
# ============================================
NODE_ENV=test
ENVIRONMENT=test

# ============================================
# Supabase 配置（测试项目）
# ============================================

# Supabase 项目 URL
# 格式: https://your-test-project-id.supabase.co
# 获取方式: Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://xxxxx-test.supabase.co

# Supabase 匿名密钥（客户端使用）
# 获取方式: Supabase Dashboard > Settings > API > anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase 服务端密钥（服务端使用，保密！）
# 获取方式: Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL 连接字符串（用于 migrations）
# 格式: postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx-test.supabase.co:5432/postgres

# ============================================
# API 配置
# ============================================

# API 端口
PORT=3000

# API 基础路径
API_BASE_PATH=/api/v1

# CORS 允许的域名（逗号分隔）
CORS_ORIGINS=http://localhost:3000,https://test.dacong.app

# ============================================
# 前端配置
# ============================================

# 前端测试域名
FRONTEND_URL=https://test.dacong.app

# API 基础 URL
API_URL=https://xxxxx-test.supabase.co/functions/v1

# ============================================
# 爬虫配置（测试环境使用较低频率）
# ============================================

# GitHub Token（用于提高 API 限流）
GITHUB_TOKEN=ghp_xxxxx

# OpenRouter API Key（用于 AI 生成内容）
OPENROUTER_API_KEY=sk-or-xxxxx

# 爬虫运行间隔（分钟）
SPIDER_INTERVAL=60

# ============================================
# 日志配置
# ============================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=debug

# 日志格式: json, pretty
LOG_FORMAT=json

# ============================================
# 监控配置
# ============================================

# 健康检查端点
HEALTH_CHECK_URL=https://xxxxx-test.supabase.co/functions/v1/health

# 告警邮箱
ALERT_EMAIL=dev@dacong.app

# ============================================
# 测试数据配置
# ============================================

# 是否使用测试数据
USE_TEST_DATA=true

# 测试用户邮箱
TEST_USER_EMAIL=test@dacong.app
