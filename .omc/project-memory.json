  "resolvedIssues": [
    {
      "issue": "Vercel API 重定向返回 fingerprint/tracking HTML",
      "solution": "改用 Supabase 直连，绕过 Vercel API"
    },
    {
      "issue": "Cloudflare Workers 不支持 Node.js (@supabase/ssr 构建失败)",
      "solution": "改用 @supabase/supabase-js 直连 + 静态导出"
    },
    {
      "issue": "动态路由导致静态导出失败",
      "solution": "移除 /api 目录，直接在前端组件内请求 Supabase"
    },
    {
      "issue": "Netlify 找不到部署目录 (404)",
      "solution": "设置 Base directory 为 dacong-console"
    },
    {
      "issue": "GitHub Actions 网络连接问题",
      "solution": "用户手动推送代码，Netlify GitHub 集成自动部署"
    },
    {
      "issue": "BaseRankingsSpider.run() 接口不兼容 SpiderBase",
      "solution": "添加可选参数 async def run(self, fetcher=None, writer=None)"
    }
  ],
  "completedFeatures": [
    "静态站点导出",
    "Supabase 直连认证",
    "GitHub Actions 自动化部署",
    "Netlify CDN 托管",
    "LMArena 排行榜数据抓取",
