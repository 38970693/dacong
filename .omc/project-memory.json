    "nextConfig": "dacong-console/next.config.ts",
    "supabaseClient": "dacong-console/src/utils/supabase/client.ts",
    "mainPage": "dacong-console/src/app/page.tsx",
    "workflow": ".github/workflows/deploy-console.yml",
    "spiderMain": "dacong-spider/run_rankings.py",
    "spiderBase": "dacong-spider/spiders/rankings_base.py",
