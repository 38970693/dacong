{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "node": "20"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npx tsx src/index.ts",
    "healthCheckPath": "/health/live",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
