# ── Database Configuration ──────────────────────────
POSTGRES_DB=dacong
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ── Redis Configuration ──────────────────────────────
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# ── Supabase Configuration ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── AI Configuration ─────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Application Ports ────────────────────────────────
API_PORT=8000
CLIENT_PORT=80
ADMIN_PORT=8080

# ── Application Configuration ────────────────────────
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080

# ── Spider Configuration ─────────────────────────────
SPIDER_INTERVAL=3600
MAX_WORKERS=4

# ── CDN Configuration ────────────────────────────────
CDN_URL=https://cdn.dacong.ai
ENABLE_CDN=true
FALLBACK_URL=https://dacong.ai

# ── Cloudflare Configuration ─────────────────────────
CLOUDFLARE_ZONE_ID=your-zone-id-here
CLOUDFLARE_API_TOKEN=your-api-token-here

# ── Sentry Error Monitoring ──────────────────────────
# Flutter Client Sentry DSN
SENTRY_DSN_FLUTTER=https://your-flutter-dsn@sentry.io/project-id

# Edge Functions Sentry DSN
SENTRY_DSN=https://your-api-dsn@sentry.io/project-id

# Python Spider Sentry DSN
SENTRY_DSN_SPIDER=https://your-spider-dsn@sentry.io/project-id

# Sentry Environment (development/staging/production)
ENVIRONMENT=production
