# DaCong Spider 环境变量配置
# 复制此文件为 .env 并填入真实值

# ── Supabase ──────────────────────────────────────
# 项目设置 → API 中找到
SUPABASE_URL=https://your-project.supabase.co

# 项目设置 → API → service_role 密钥（不要泄露！）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GitHub API ──────────────────────────────────────
# GitHub Personal Access Token (用于提高 API 限额)
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# ── Reddit API ──────────────────────────────────────
# Reddit App 配置: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DaCong-Spider/1.0

# ── OpenRouter API ──────────────────────────────────
# OpenRouter API Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# ── 爬虫开关 ──────────────────────────────────────
SPIDER_GITHUB_ENABLED=true
SPIDER_HUGGINGFACE_ENABLED=true
SPIDER_HACKERNEWS_ENABLED=true
SPIDER_OPENROUTER_ENABLED=true
SPIDER_REDDIT_ENABLED=true

# ── 社交源：Bluesky（免费，推荐）────────────────────
# public.api.bsky.app 是公开只读端点，不需要任何凭证，开箱即用。
SPIDER_BLUESKY_ENABLED=true
BSKY_INTERVAL_MINUTES=30
# 留空用内置已验证账号；自定义示例（逗号分隔，handle 必须真实存在）：
# BSKY_KOL_ACCOUNTS=karpathy.bsky.social,simonwillison.net,emollick.bsky.social
# BSKY_KEYWORDS=LLM,AI agent,open source AI

# ── 社交源：X / Twitter（付费，默认不跑）──────────────
# 免费优先策略：不配 X_BEARER_TOKEN 时该爬虫直接跳过，不产生任何请求。
# X 的 Nitter / xcancel 免费镜像已于 2026-08-24 被 X Corp 关停，别指望它们。
# 真要接 X 就去 developer.x.com 买 Basic 档（$200/月），然后填：
# X_BEARER_TOKEN=
SPIDER_X_ENABLED=true
X_INTERVAL_MINUTES=30
# X_KOL_ACCOUNTS=thsottiaux,karpathy,sama,ylecun
# X_KEYWORDS=AI,LLM,GPT
# X_MIRRORS=          # 留空；只有你找到「还能返回 RSS」的镜像时才填，逗号分隔
#                     # 2026-09 实测：42 个公开 Nitter 实例里只剩 nitter.tiekoetter.com 能开页面，
#                     # 但它返回 "RSS feed is disabled"，对本爬虫无用

# ── 调度配置 ──────────────────────────────────────
# 爬虫运行间隔（小时）
GITHUB_INTERVAL_HOURS=1
HUGGINGFACE_INTERVAL_HOURS=6
HACKERNEWS_INTERVAL_HOURS=1
OPENROUTER_INTERVAL_HOURS=24
REDDIT_INTERVAL_HOURS=24

# ── HTTP 配置 ──────────────────────────────────────
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=5

# ── 日志配置 ──────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/dacong_spider.log
SPIDER_DEBUG=false

# ── 数据库配置 ──────────────────────────────────────
# 批量写入大小
BATCH_SIZE=100

# ── 代理配置（可选）──────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
