    "cheerio": "^1.2.0",
    "commander": "^13.0.0",
    "csv-writer": "^1.6.0",
    "puppeteer": "^23.10.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
