{
  "name": "ai-model-leaderboard-scraper",
  "version": "1.0.0",
  "description": "Multi-source scraper for AI model ranking websites with JavaScript rendering support",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "scrape": "node src/index.js",
    "scrape:lmarena": "node src/index.js lmarena",
    "scrape:swebench": "node src/index.js swebench",
    "scrape:all": "node src/index.js all",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint src/"
  },
  "keywords": [
    "scraper",
